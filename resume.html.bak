                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <button onclick="next(event)" class="w-10 h-10 rounded-full border border-white/10 flex items-center justify-center text-gray-400 hover:text-white hover:bg-white/5 transition-all">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>

                <!-- Custom Progress Indicators -->
                <div class="flex-1 px-8 hidden sm:block">
                    <div class="w-full bg-gray-800 h-1 rounded-full overflow-hidden">
                        <div id="progressBar" class="bg-blue-500 h-full transition-all duration-300" style="width: 12.5%;"></div>
                    </div>
                </div>

                <!-- Slide counter & reset -->
                <div class="flex items-center gap-4 text-xs font-semibold uppercase tracking-wider text-gray-400">
                    <span id="slideCounter">01 / 08</span>
                    <button onclick="resetCurrentSlide(event)" class="text-gray-500 hover:text-white transition-colors" title="Reset Slide Steps">
                        <i class="fa-solid fa-rotate-right"></i>
                    </button>
                </div>
            </div>

        </div>

    </main>

    <!-- Slide Deck Logic Script -->
    <script>
        const slides = Array.from(document.querySelectorAll('.slide-frame'));
        const timelineItems = Array.from(document.querySelectorAll('.timeline-item'));
        const progressBar = document.getElementById('progressBar');
        const slideCounter = document.getElementById('slideCounter');
        const ambientGlow = document.getElementById('ambientGlow');
        const slideViewport = document.getElementById('slideViewport');

        let currentSlideIndex = 0;
        let currentStepIndex = -1;

        // Colors mapping for sidebar nodes
        const slideColors = [
            '#3b82f6', // blue
            '#10b981', // emerald
            '#6366f1', // indigo
            '#f97316', // orange
            '#a855f7', // purple
            '#14b8a6', // teal
            '#2563eb', // blue-dark
            '#8b5cf6'  // violet
        ];

        function getStepsForSlide(slideIndex) {
            return Array.from(slides[slideIndex].querySelectorAll('.step'));
        }

        function showSlide(slideIndex, direction = 'forward') {
            // Validate limits
            if (slideIndex < 0 || slideIndex >= slides.length) return;

            // Deactivate previous active slides
            slides.forEach((slide) => {
                slide.classList.remove('active', 'slide-in-right', 'slide-in-left');
            });

            // Activate slide frame
            const activeSlide = slides[slideIndex];
            activeSlide.classList.add('active');
            
            // Add slide transitions
            if (direction === 'forward') {
                activeSlide.classList.add('slide-in-right');
            } else if (direction === 'backward') {
                activeSlide.classList.add('slide-in-left');
            }

            // Set slide color themes in background and index nodes
            const glowValue = activeSlide.getAttribute('data-theme-glow') || 'none';
            ambientGlow.style.background = glowValue;
            
            // Update active state in sidebar index
            timelineItems.forEach((item, idx) => {
                item.classList.remove('active');
                item.style.setProperty('--theme-color', slideColors[slideIndex]);
                if (idx === slideIndex) {
                    item.classList.add('active');
                }
            });

            currentSlideIndex = slideIndex;

            // Handle steps configuration
            const steps = getStepsForSlide(slideIndex);
            if (direction === 'backward') {
                // If moving backward, start slide with all steps already revealed
                currentStepIndex = steps.length - 1;
                steps.forEach(step => step.classList.add('revealed'));
            } else {
                // If moving forward, start slide with no steps revealed
                currentStepIndex = -1;
                steps.forEach(step => step.classList.remove('revealed'));
            }

            updateUI();
        }

        function updateUI() {
            // Update counter text
            const displayIndex = String(currentSlideIndex + 1).padStart(2, '0');
            const totalIndex = String(slides.length).padStart(2, '0');
            slideCounter.textContent = `${displayIndex} / ${totalIndex}`;

            // Calculate progress value: base progress + step progress
            const baseProgress = (currentSlideIndex / slides.length) * 100;
            const steps = getStepsForSlide(currentSlideIndex);
            
            let stepOffset = 0;
            if (steps.length > 0) {
                stepOffset = ((currentStepIndex + 1) / steps.length) * (100 / slides.length);
            }
            
            const totalProgress = baseProgress + stepOffset;
            progressBar.style.width = `${Math.max(totalProgress, 2)}%`;
            progressBar.style.backgroundColor = slideColors[currentSlideIndex];
        }

        // Action when advancing
        function next(e) {
            if (e) e.stopPropagation();
            const steps = getStepsForSlide(currentSlideIndex);
            
            if (currentStepIndex < steps.length - 1) {
                currentStepIndex++;
                steps[currentStepIndex].classList.add('revealed');
                updateUI();
            } else {
                // Advance slide
                if (currentSlideIndex < slides.length - 1) {
                    showSlide(currentSlideIndex + 1, 'forward');
                }
            }
        }

        // Action when going back
        function prev(e) {
            if (e) e.stopPropagation();
            const steps = getStepsForSlide(currentSlideIndex);
            
            if (currentStepIndex >= 0) {
                steps[currentStepIndex].classList.remove('revealed');
                currentStepIndex--;
                updateUI();
            } else {
                // Return to previous slide
                if (currentSlideIndex > 0) {
                    showSlide(currentSlideIndex - 1, 'backward');
                }
            }
        }

        function resetCurrentSlide(e) {
            if (e) e.stopPropagation();
            const steps = getStepsForSlide(currentSlideIndex);
            currentStepIndex = -1;
            steps.forEach(step => step.classList.remove('revealed'));
            updateUI();
        }

        function jumpToSlide(slideIndex) {
            if (slideIndex === currentSlideIndex) return;
            const direction = slideIndex > currentSlideIndex ? 'forward' : 'backward';
            showSlide(slideIndex, direction);
        }

        // Mouse click on viewport triggers 'next'
        slideViewport.addEventListener('click', (e) => {
            // Don't trigger if clicked on control buttons or anchors or inside tables/thead
            if (e.target.closest('button') || e.target.closest('a') || e.target.closest('table') || e.target.closest('thead')) {
                return;
            }
            next();
        });

        // Keyboard arrows navigation
        document.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
                e.preventDefault();
                next();
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                e.preventDefault();
                prev();
            } else if (e.key === 'r' || e.key === 'R') {
                resetCurrentSlide();
            }
        });

        // Initialize presentation
        document.addEventListener('DOMContentLoaded', () => {
            showSlide(0, 'forward');
        });
    </script>
</body>

</html>
