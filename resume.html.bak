                <!-- Slide Body Content -->
                <div class="my-auto grid md:grid-cols-2 gap-12 items-center flex-1 py-6 min-h-0 overflow-hidden">
                    <div class="space-y-4 max-h-[340px] overflow-y-auto pr-2 slide-content">
                        <ul class="space-y-4 text-xs md:text-base text-gray-300 font-light leading-relaxed">
                            <li class="step flex items-start gap-3">
                                <i class="fa-solid fa-dna text-purple-400 mt-1 text-sm"></i>
                                <span><strong>High-Risk Prediction:</strong> Classifies high-risk oral cancer patients directly from Whole Slide Images (WSI) with <strong>AUC > 0.85</strong>.</span>
                            </li>
                            <li class="step flex items-start gap-3">
                                <i class="fa-solid fa-dna text-purple-400 mt-1 text-sm"></i>
                                <span><strong>Contrastive Feature Alignment:</strong> Aligned standard pathology visual features directly with Immune-Omics parameters using Cosine Similarity loss.</span>
                            </li>
                            <li class="step flex items-start gap-3">
                                <i class="fa-solid fa-dna text-purple-400 mt-1 text-sm"></i>
                                <span><strong>Multiple Instance Learning:</strong> Trained an Attention-based MIL head (sigmoid activation) to aggregate tile features per WSI.</span>
                            </li>
                            <li class="step flex items-start gap-3">
                                <i class="fa-solid fa-dna text-purple-400 mt-1 text-sm"></i>
