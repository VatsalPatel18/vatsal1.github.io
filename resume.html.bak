<!DOCTYPE html>
<html lang="en" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vatsal Patel | Interactive Research Presentation</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #030712;
            color: #f5f5f7;
            -webkit-font-smoothing: antialiased;
            overflow: hidden;
        }

        /* Ambient Glow Backdrop */
        .ambient-glow {
            position: fixed;
            inset: 0;
            z-index: -2;
            transition: background 1.2s cubic-bezier(0.25, 1, 0.5, 1);
            pointer-events: none;
        }

        /* Glassmorphism Sidebar */
        .glass-sidebar {
            background: rgba(17, 24, 39, 0.4);
            backdrop-filter: saturate(180%) blur(25px);
            -webkit-backdrop-filter: saturate(180%) blur(25px);
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Slide Widescreen Canvas */
        .slide-canvas {
            aspect-ratio: 16 / 9;
            background: rgba(10, 11, 15, 0.85);
            backdrop-filter: saturate(180%) blur(20px);
            -webkit-backdrop-filter: saturate(180%) blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
        }

        /* Slide Transitions */
        .slide-frame {
            display: none;
            width: 100%;
            height: 100%;
            opacity: 0;
        }

        .slide-frame.active {
            display: flex;
            opacity: 1;
        }

        .slide-in-right {
            animation: slideInRight 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .slide-in-left {
            animation: slideInLeft 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes slideInRight {
            from {
                transform: translateX(30px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes slideInLeft {
            from {
                transform: translateX(-30px);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        /* Step-by-step elements */
        .step {
            opacity: 0;
            transform: translateY(12px);
            transition: opacity 0.5s cubic-bezier(0.25, 1, 0.5, 1), transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .step.revealed {
            opacity: 1;
            transform: translateY(0);
        }

        /* Timeline Navigation List */
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -17px;
            top: 10px;
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background-color: #374151;
            transition: all 0.3s;
        }

        .timeline-item.active {
            color: #ffffff;
            font-weight: 600;
        }

        .timeline-item.active::before {
            background-color: var(--theme-color, #3b82f6);
            box-shadow: 0 0 10px var(--theme-color, #3b82f6);
            transform: scale(1.4);
        }

        /* Custom scrollbar for slides */
        .slide-content::-webkit-scrollbar {
            width: 6px;
        }

        .slide-content::-webkit-scrollbar-track {
            background: transparent;
        }

        .slide-content::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.15);
            border-radius: 3px;
        }

        .slide-content::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 255, 255, 0.3);
        }
    </style>
</head>

<body class="selection:bg-blue-500/30 selection:text-white flex h-screen w-screen relative overflow-hidden font-sans">

